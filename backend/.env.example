# Copy to .env and fill in. Never commit the real .env file.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use local SQLite. Production example:
# DATABASE_URL=postgres://user:password@host:5432/edumind
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# AI provider (server-side only, never exposed to the frontend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
AI_RATE_LIMIT=20/minute

MAX_UPLOAD_SIZE_MB=5
